{
  "name": "__MSG_extName__",
  "description": "__MSG_extDescription__",
  "version": "0.6.2",
  "manifest_version": 3,
  "default_locale": "en",
  "omnibox": {
    "keyword": "j"
  },
  "background": {
    "scripts": [
      "service-worker.js"
    ],
    "type": "module"
  },
  "permissions": [
    "storage"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "img/icon-16.png",
      "32": "img/icon-32.png",
      "48": "img/icon-48.png",
      "128": "img/icon-128.png"
    }
  },
  "icons": {
    "16": "img/icon-16.png",
    "32": "img/icon-32.png",
    "48": "img/icon-48.png",
    "128": "img/icon-128.png"
  },
  "options_page": "options.html",
  "browser_specific_settings": {
    "gecko": {
      "id": "jump@jump-shortcuts.click",
      "strict_min_version": "142.0",
      "data_collection_permissions": {
        "required": ["none"]
      }
    }
  }
}
